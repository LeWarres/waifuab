      m_Items: []
  - m_Id: 2727810553950216
    m_Localized: "Regeneraci\xF3n\nEl tren y el h\xE9roe se curan poco a poco"
    m_Metadata:
      m_Items: []
  - m_Id: 2727810553950217
    m_Localized: "\xC1rea\n+12% de tama\xF1o de explosiones y barridos"
    m_Metadata:
      m_Items: []
  - m_Id: 2727810553950218
    m_Localized: 'Cantidad

      Tu arma: +1 disparo; +2 en nivel 4'
    m_Metadata:
      m_Items: []
  - m_Id: 2727810553950219
    m_Localized: "Suerte\nM\xE1s premios y cofres dorados"
    m_Metadata:
      m_Items: []
  - m_Id: 2727810553950220
    m_Localized: "Duraci\xF3n\nRalentizar, bumeranes y cortes duran +20%"
    m_Metadata:
      m_Items: []
  - m_Id: 2727810553950221
    m_Localized: "Conservar\nRegeneraci\xF3n"
