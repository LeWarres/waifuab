  - m_Id: 5800277656809480
    m_Localized: Beat a biome boss.
    m_Metadata:
      m_Items: []
  - m_Id: 5800277656809481
    m_Localized: Clean sweep
    m_Metadata:
      m_Items: []
  - m_Id: 5800277656809482
    m_Localized: Defeat 500 enemies in one run.
    m_Metadata:
      m_Items: []
  - m_Id: 5800277656809483
    m_Localized: Exterminator
    m_Metadata:
      m_Items: []
  - m_Id: 5800277656809484
    m_Localized: Defeat 2000 enemies in one run.
    m_Metadata:
      m_Items: []
  - m_Id: 5800277656809485
    m_Localized: Evolution
    m_Metadata:
      m_Items: []
  - m_Id: 5800277656809486
    m_Localized: Evolve a weapon.
    m_Metadata:
      m_Items: []
  - m_Id: 5800277656809487
    m_Localized: Legendary chest
    m_Metadata:
      m_Items: []
  - m_Id: 5800277656809488
    m_Localized: Open a legendary chest.
    m_Metadata:
      m_Items: []
  - m_Id: 5800277656809489
    m_Localized: Long train
    m_Metadata:
      m_Items: []
  - m_Id: 5800277656809490
    m_Localized: Pull 8 wagons at once.
    m_Metadata:
      m_Items: []
  - m_Id: 5800277656809491
    m_Localized: Deep pockets
    m_Metadata:
      m_Items: []
  - m_Id: 5800277656809492
    m_Localized: Hold 1000 money.
    m_Metadata:
      m_Items: []
  - m_Id: 5800277656809493
    m_Localized: Meteor shower
    m_Metadata:
      m_Items: []
  - m_Id: 5800277656809494
    m_Localized: Use your ultimate.
    m_Metadata:
      m_Items: []
  - m_Id: 5800277656809495
    m_Localized: First chapter
    m_Metadata:
