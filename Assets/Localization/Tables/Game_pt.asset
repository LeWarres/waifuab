    m_Localized: Voltar
    m_Metadata:
      m_Items: []
  - m_Id: 1762996245
    m_Localized: "Anal\xF3gico ou direcional  esquerda / direita: mover a sele\xE7\xE3o       
      X: confirmar"
    m_Metadata:
      m_Items: []
  - m_Id: 1762996246
    m_Localized: "A / D ou setas: mover a sele\xE7\xE3o        Espa\xE7o: confirmar       
      ou clique"
    m_Metadata:
      m_Items: []
  - m_Id: 1762996247
    m_Localized: Jogador
    m_Metadata:
      m_Items: []
  - m_Id: 1762996248
