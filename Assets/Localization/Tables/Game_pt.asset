  - m_Id: 1762996224
    m_Localized: Trem {0} / {1}
    m_Metadata:
      m_Items: []
  - m_Id: 1762996225
    m_Localized: "Idioma: Portugu\xEAs (L)"
    m_Metadata:
      m_Items: []
  - m_Id: 1762996226
    m_Localized: "Trem destru\xEDdo. Reiniciar?"
    m_Metadata:
      m_Items: []
  - m_Id: 1762996227
    m_Localized: Sim
    m_Metadata:
      m_Items: []
  - m_Id: 1762996228
    m_Localized: "N\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 1762996229
    m_Localized: "Antes de partir   \xB7   Pr\xF3ximo trecho: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1762996230
    m_Localized: "Reparar +{0} por vag\xE3o\n({1} dinheiro)"
    m_Metadata:
      m_Items: []
  - m_Id: 1762996231
    m_Localized: 'Curar jogador +{0}

      ({1} dinheiro)'
    m_Metadata:
      m_Items: []
  - m_Id: 1762996232
    m_Localized: 'Continuar em

      {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 1762996233
    m_Localized: 'Mudar para {0}

      (dificuldade +{1}, dinheiro x{2})'
    m_Metadata:
      m_Items: []
  - m_Id: 1762996234
    m_Localized: "Esta\xE7\xE3o: melhoria dos vag\xF5es"
    m_Metadata:
      m_Items: []
  - m_Id: 1762996235
    m_Localized: 'Dinheiro +{0}

      para reparar e curar'
    m_Metadata:
      m_Items: []
  - m_Id: 1762996236
    m_Localized: "Pular\nvida ou dinheiro aleat\xF3rio"
    m_Metadata:
      m_Items: []
  - m_Id: 1762996237
    m_Localized: "{0}: em qual vag\xE3o?"
    m_Metadata:
      m_Items: []
  - m_Id: 1762996238
    m_Localized: "Vag\xE3o {0}\n{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1762996239
