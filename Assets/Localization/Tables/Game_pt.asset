    m_Metadata:
      m_Items: []
  - m_Id: 1313663740096516
    m_Localized: "Saldo dispon\xEDvel: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1313663740096517
    m_Localized: "Continuar \xB7 A / Enter"
    m_Metadata:
      m_Items: []
  - m_Id: 1313663740096518
    m_Localized: "N\xE3o h\xE1 carga para entregar nesta esta\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1313663740096519
    m_Localized: "Vag\xE3o de escolta"
    m_Metadata:
