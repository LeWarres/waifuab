      m_Items: []
  - m_Id: 2727810553950216
    m_Localized: "Regenera\xE7\xE3o\\n+1 PV/s dividido entre vag\xF5es danificados\\n+0,5
      PV/s para o her\xF3i por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 2727810553950217
    m_Localized: "\xC1rea\n+12% no tamanho de explos\xF5es e varreduras"
    m_Metadata:
      m_Items: []
  - m_Id: 2727810553950218
    m_Localized: "Quantidade\\nSua arma: +1 disparo por n\xEDvel (m\xE1x. +2)"
    m_Metadata:
      m_Items: []
  - m_Id: 2727810553950219
    m_Localized: "Sorte\nMais pr\xEAmios e ba\xFAs dourados"
    m_Metadata:
      m_Items: []
  - m_Id: 2727810553950220
    m_Localized: "Dura\xE7\xE3o\nLentid\xE3o, bumerangues e cortes duram +20%"
    m_Metadata:
      m_Items: []
  - m_Id: 2727810553950221
    m_Localized: "Manter\nRegenera\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 2727810553950222
