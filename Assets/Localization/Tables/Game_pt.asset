    m_Metadata:
      m_Items: []
  - m_Id: 1313663740096518
    m_Localized: "N\xE3o h\xE1 carga para entregar nesta esta\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1313663740096519
    m_Localized: "Vag\xE3o de escolta"
